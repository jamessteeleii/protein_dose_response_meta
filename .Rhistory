set.seed(123)  # for reproducibility
n_studies <- 32
n_coders <- 4
n_coders_per_study <- 2
studies <- 1:n_studies
# generate all possible coder pairs
coder_pairs <- combn(1:n_coders, n_coders_per_study, simplify = FALSE)
coder_pairs
# randomly assign a pair to each study
assignments <- data.frame(
study = studies,
coders = sample(coder_pairs, n_studies, replace = TRUE)
)
assignments
# expand so each row is study-coder
assignments_long <- do.call(rbind, lapply(1:nrow(assignments), function(i) {
data.frame(study = assignments$study[i],
coder = assignments$coders[[i]])
}))
assignments$study[i]
1:nrow(assignments)
View(assignments)
?sample
