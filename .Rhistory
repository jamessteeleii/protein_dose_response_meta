set.seed(123)
n_studies <- 32
n_coders <- 4
studies <- 1:n_studies
# Step 1: all unique coder pairs
coder_pairs <- combn(1:n_coders, 2, simplify = FALSE)
# Step 2: allocate studies evenly across pairs
pair_allocation <- rep(coder_pairs, length.out = n_studies)
pair_allocation <- sample(pair_allocation)  # shuffle
pair_allocation
assignments <- data.frame(
study = studies,
coders = I(pair_allocation)
)
assignments
# Step 3: expand into study × coder format
assignments_long <- do.call(rbind, lapply(1:nrow(assignments), function(i) {
data.frame(study = assignments$study[i],
coder = assignments$coders[[i]])
}))
# Check balance
table(assignments_long$coder)
assignments_long[order(assignments_long$study), ]
# Check balance
table(assignments_long$coder)
