set.seed(123)
n_studies <- 32
n_coders <- 4
studies <- 1:n_studies
# Build all possible study-coder slots (32 studies × 2 slots = 64 total slots)
slots <- rep(studies, each = 2)
# Assign exactly 16 slots to each coder
coder_ids <- rep(1:n_coders, each = n_studies / n_coders * 2) # 16 × 4 = 64
coder_ids <- sample(coder_ids) # shuffle to randomize
assignments_long <- data.frame(
study = slots,
coder = coder_ids
)
# Now enforce that each study has 2 unique coders
fix_duplicates <- function(df) {
for (s in unique(df$study)) {
coders <- df$coder[df$study == s]
# if both coders are the same, swap one with a different study
if (length(unique(coders)) == 1) {
other <- sample(setdiff(unique(df$study), s), 1)
# find a swap candidate
swap_idx <- which(df$study == other)[1]
df$coder[df$study == s][1] <- df$coder[swap_idx]
df$coder[swap_idx] <- coders[1]
}
}
df
}
assignments_long <- fix_duplicates(assignments_long)
# Check balance
print(table(assignments_long$coder))
print(aggregate(coder ~ study, data = assignments_long, length)) # each = 2
assignments_long[order(assignments_long$study), ]
library(dplyr)
library(tidyr)
coder_schedule <- assignments_long %>%
arrange(coder, study) %>%
group_by(coder) %>%
summarise(studies = list(study), .groups = "drop") %>%
mutate(studies = lapply(studies, function(x) sort(x))) %>%
# turn list of studies into wide columns
unnest_wider(studies, names_sep = "_")
# rename columns nicely
names(coder_schedule) <- c("coder", paste0("study_", 1:(ncol(coder_schedule)-1)))
coder_schedule
set.seed(123)
n_studies <- 32
n_coders <- 4
# All 6 possible coder pairs
pairs <- combn(1:n_coders, 2, simplify = FALSE)
# Repeat pairs until we cover all studies
pair_seq <- rep(pairs, length.out = n_studies)
# Shuffle for randomness
pair_seq <- sample(pair_seq)
# Assign each study a pair
assignments <- data.frame(
study = 1:n_studies,
coder1 = sapply(pair_seq, `[[`, 1),
coder2 = sapply(pair_seq, `[[`, 2)
)
# Long form
assignments_long <- tidyr::pivot_longer(assignments,
cols = c(coder1, coder2),
values_to = "coder",
names_to = NULL)
# Check balance
print(table(assignments_long$coder))     # should be 16 each
print(all(aggregate(coder ~ study, assignments_long, length)$coder == 2)) # TRUE
# Now pivot to wide "coder × 16 studies"
library(dplyr)
library(tidyr)
coder_schedule <- assignments_long %>%
arrange(coder, study) %>%
group_by(coder) %>%
summarise(studies = list(sort(unique(study))), .groups = "drop") %>%
tidyr::unnest_wider(studies, names_sep = "_")
names(coder_schedule) <- c("coder", paste0("study_", 1:(ncol(coder_schedule)-1)))
coder_schedule
n_studies <- 32
n_coders <- 4
assignments <- data.frame(
study = 1:n_studies,
coder1 = ((1:n_studies - 1) %% n_coders) + 1,
coder2 = ((1:n_studies - 1 + 1) %% n_coders) + 1
)
# Long form
library(tidyr)
assignments_long <- pivot_longer(assignments,
cols = c(coder1, coder2),
values_to = "coder",
names_to = NULL)
# Check: each coder should have exactly 16
print(table(assignments_long$coder))
# Now build the wide "coder × 16 studies" table
library(dplyr)
coder_schedule <- assignments_long %>%
arrange(coder, study) %>%
group_by(coder) %>%
summarise(studies = list(sort(unique(study))), .groups = "drop") %>%
tidyr::unnest_wider(studies, names_sep = "_")
names(coder_schedule) <- c("coder", paste0("study_", 1:(ncol(coder_schedule)-1)))
coder_schedule
assignments_long |>
group_by(study) |>
count()
n <- assignments_long |>
group_by(study) |>
count()
View(n)
write.csv(coder_schedule, "study_allocation.csv")
